# IP-SAKTI — environment variables.
#
# Copy to `.env` for local development. `.env` is gitignored and excluded from
# the Docker image; production values are set in the Render dashboard, and
# nothing here may be relied on to reach a deployment.
#
# Only GROQ_API_KEY is required. Everything below it is optional, but a value
# that matters in production should be set there EXPLICITLY rather than left to
# a default that a future commit may change.

# ── Required in production ───────────────────────────────────────────────────

# Groq credential. Never commit a real value. In Render: Dashboard → Environment
# → Add Environment Variable (render.yaml marks it `sync: false` for this reason).
GROQ_API_KEY=gsk_replace_me

# Google Cloud Translation uses Application Default Credentials on the
# Next.js server only. Point this at your local service-account file; never copy
# the JSON into this repository or expose this value through NEXT_PUBLIC_*.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Server-only alternative for hosts such as Vercel, where a local JSON path is
# not available. Copy these three values into the host's encrypted/sensitive
# environment settings. Never prefix them with NEXT_PUBLIC_. Keep the escaped
# `\n` characters in the private key; the server adapter restores line breaks.
GOOGLE_CLOUD_PROJECT_ID=replace-with-project-id
GOOGLE_CLOUD_CLIENT_EMAIL=replace-with-service-account-email
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# ── Recommended to set explicitly in Render ──────────────────────────────────

# Per-request timeout, in seconds. HARD-CLAMPED to 15.0 by MAX_TIMEOUT_SECONDS
# in ai/answering/groq.py — a value above it is lowered, not honoured. 15 is
# also the default, so setting it here changes nothing today; it is worth
# setting anyway so production does not silently inherit a default that moves.
#
# Measured basis: prompts run 1,950-4,400 tokens and a local completion took
# ~1.1 s. If the deployed diagnostic starts reporting "exceeded the 15s
# timeout", the ceiling itself is what needs raising, not this value.
GROQ_TIMEOUT_SECONDS=15

# Answer model. Recorded on every draft; an answer from an unrecorded model is
# not a reproducible result.
GROQ_MODEL=openai/gpt-oss-120b

# Completion ceiling, clamped to [384, 800]. Leave at 800 unless you are
# deliberately trading truncation risk for headroom under a rate limit: two
# recorded live runs used 210 and 328 tokens and both finished on `stop`, and
# a successful request bills what it used rather than this ceiling.
GROQ_MAX_COMPLETION_TOKENS=800

# ── Server configuration (all optional; CLI flags override) ──────────────────

# IPSAKTI_PROVIDER=groq            # auto | groq | extractive
# IPSAKTI_DENSE=0                  # 0 disables BGE-M3 (production runs without it)
# IPSAKTI_RERANKER=features        # features | cross_encoder
# IPSAKTI_CACHE=1                  # 0 disables the validated-answer cache
# IPSAKTI_CACHE_PATH=data/cache/validated_answers.json
# IPSAKTI_SEED_CACHE_PATH=data/demo_cache/validated_demo_answers.json
# IPSAKTI_CORS_ORIGINS=*
