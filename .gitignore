apps/server/.env

# Cloud service-account credentials. Keep local ADC files outside the repo;
# these patterns are a second guard against accidental staging.
*-service-account*.json
*service_account*.json
*serviceaccount*.json
google-credentials*.json
gcp-credentials*.json
geometric-petal-*.json

data/raw/
data/interim/

# Phase 4: the BGE-M3 embedding cache. Regenerated deterministically from the
# corpus by ai/retrieval/dense.py; 12 MB of derived floats does not belong in git.
data/evaluation/embeddings/

# Node & Turborepo
node_modules/
.turbo/
.next/
dist/
.DS_Store
.qodo/

# The validated-answer cache. Written at runtime from real pipeline results and
# regenerated by scripts/demo/warm_cache.py; keyed to a corpus/prompt/provider
# fingerprint, so a committed copy would be stale the moment any of them moved.
data/cache/

# Derived evaluation rows, regenerated deterministically and not worth their weight
# in history. `run_submission_eval.py --fresh` rebuilds retrieval_1000.jsonl in
# about 60 seconds with no provider call; the summary, the failure table and the
# judge verdicts derived from it are committed.
data/evaluation/results/submission/retrieval_1000.jsonl
data/evaluation/results/submission/judge_batches/*.txt
